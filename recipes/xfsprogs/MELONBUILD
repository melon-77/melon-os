pkgname=xfsprogs
pkgver=6.18.0
pkgdesc="XFS filesystem utilities (mkfs.xfs, xfs_repair, ...)"
license="GPL-2.0-only AND LGPL-2.1-only"
url=https://xfs.wiki.kernel.org
source=(xfsprogs-6.18.0.tar.xz)
makedepends=(util-linux-dev userspace-rcu-dev inih-dev linux-headers)
build(){
  export DEBUG=-DNDEBUG OPTIMIZER="$CFLAGS" LOCAL_CONFIGURE_OPTIONS=
  ./configure $conf_flags --enable-gettext=no --disable-libicu --enable-scrub=no --enable-lto=no \
     --with-systemd-unit-dir=no --with-udev-rule-dir=no --with-crond-dir=no >/dev/null
  make -j$JOBS BUILD_CC=gcc >/dev/null
}
package(){ make DIST_ROOT=$pkgdir install >/dev/null; rm -rf $pkgdir/usr/share/{man,doc} $pkgdir/usr/lib/xfsprogs/xfs_scrub* ; }
