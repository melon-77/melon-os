pkgname=lxqt-config
pkgver=2.4.0
pkgrel=0
pkgdesc="LXQt settings (appearance, input, locale, ...)"
license="LGPL-2.1-or-later (see sources)"
url=https://lxqt-project.org
source=(lxqt-config-2.4.0.tar.xz)
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DUPDATE_TRANSLATIONS=OFF -DQt6LinguistTools_DIR=$M/hosttools/qt6/lib/cmake/Qt6LinguistTools -DWITH_TOUCHPAD=OFF -DCMAKE_CXX_STANDARD=20; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; }
