pkgname=zlib
pkgver=1.3.1
pkgdesc="A compression/decompression library"
license=Zlib
url=https://zlib.net
source=(zlib-1.3.1.tar.gz)
subpackages=(zlib-dev)
build(){ ./configure --prefix=/usr --libdir=/usr/lib --shared >/dev/null; make -j$JOBS >/dev/null; }
package(){ make DESTDIR=$pkgdir install >/dev/null; rm -rf $pkgdir/usr/share/man; }
