pkgname=opencv
pkgver=4.10.0
pkgrel=0
pkgdesc="OpenCV core and image processing modules (Spectacle's image tools)"
license=Apache-2.0
url=https://opencv.org
source=(opencv-4.10.0.tar.xz)
makedepends=(zlib-dev)
subpackages=(opencv-dev)
# only core + imgproc (Ubuntu's tarball has the bundled image codecs stripped; they aren't needed); nothing that downloads prebuilt binaries at build time (IPP, ADE) and no optional backends
build(){ cmake_setup -B build -DBUILD_LIST=core,imgproc -DBUILD_SHARED_LIBS=ON -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF \
  -DBUILD_EXAMPLES=OFF -DBUILD_DOCS=OFF -DBUILD_opencv_apps=OFF -DBUILD_JAVA=OFF -DBUILD_opencv_python3=OFF \
  -DWITH_IPP=OFF -DWITH_ITT=OFF -DWITH_ADE=OFF -DWITH_OPENCL=OFF -DWITH_EIGEN=OFF -DWITH_LAPACK=OFF -DWITH_PROTOBUF=OFF \
  -DWITH_TBB=OFF -DWITH_OPENMP=OFF -DWITH_GTK=OFF -DWITH_QT=OFF -DWITH_FFMPEG=OFF -DWITH_GSTREAMER=OFF -DWITH_V4L=OFF \
  -DWITH_1394=OFF -DWITH_VA=OFF -DWITH_OPENEXR=OFF -DWITH_TIFF=OFF -DWITH_JPEG=OFF -DWITH_PNG=OFF -DWITH_WEBP=OFF \
  -DWITH_OPENJPEG=OFF -DWITH_JASPER=OFF -DWITH_AVIF=OFF -DWITH_SPNG=OFF -DWITH_FLATBUFFERS=OFF -DBUILD_ZLIB=OFF -DOPENCV_GENERATE_PKGCONFIG=ON \
  -DENABLE_PRECOMPILED_HEADERS=OFF -DOPENCV_ENABLE_NONFREE=OFF; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/{doc,licenses}; }
