pkgname=plasma-nm
pkgver=6.6.6
pkgdesc="plasma-nm"
license="LGPL-2.1-or-later OR GPL-2.0-or-later (see sources)"
source=(plasma-nm-6.6.6.tar.xz)
builddir=$srcdir/plasma-nm-6.6.6
subpackages=(plasma-nm-dev)
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DBUILD_QCH=OFF -DBUILD_PYTHON_BINDINGS=OFF -DKDE_INSTALL_QTPLUGINDIR=lib/qt6/plugins -DKDE_INSTALL_QMLDIR=lib/qt6/qml -DKDE_INSTALL_LIBEXECDIR=libexec -DKF_IGNORE_PLATFORM_CHECK=ON -DBUILD_WITH_QT6=ON -DQT_MAJOR_VERSION=6 -DWITH_X11=OFF -DDISABLE_MODEMMANAGER_SUPPORT=ON; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; }
