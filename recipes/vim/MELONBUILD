pkgname=vim
pkgver=9.1.2141
pkgrel=0
pkgdesc="Vi IMproved: text editor (terminal version, normal feature set)"
license=Vim
url=https://www.vim.org
# Ubuntu 26.04's copy of the upstream 9.1.2141 release; the patches are its upstream security fixes (42 CVE patches)
source=(vim-9.1.2141.tar.xz)
makedepends=(ncurses-dev)
# a cross configure doesn't run its test programs and vim's has no defaults: the answers musl gives (Alpine's APKBUILD)
build(){
  cd src   # vim's build system lives in src/ (the patches are for the top directory)
  export vim_cv_toupper_broken=no vim_cv_terminfo=yes vim_cv_tgetent=zero vim_cv_getcwd_broken=no \
    vim_cv_stat_ignores_slash=no vim_cv_memmove_handles_overlap=yes vim_cv_bcopy_handles_overlap=no \
    vim_cv_memcpy_handles_overlap=no vim_cv_timer_create=yes vim_cv_timer_create_with_lrt=yes vim_cv_uname_output=Linux
  unset srcdir   # melon-build exports it, and vim's old configure takes it as the source directory
  ./configure $conf_flags --with-features=normal --disable-gui --without-x --disable-nls --disable-gpm --disable-sysmouse \
    --disable-selinux --disable-netbeans --disable-canberra --disable-libsodium --with-tlib=ncursesw --enable-multibyte \
    --with-compiledby=melon --disable-acl
  make -j$JOBS
}
package(){
  cd src
  make DESTDIR=$pkgdir install
  rm -rf $pkgdir/usr/share/man $pkgdir/usr/share/applications $pkgdir/usr/share/icons
}
