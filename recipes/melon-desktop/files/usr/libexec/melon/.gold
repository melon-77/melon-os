#!/bin/sh
# every gauntlet reward at once, for testing (started by a hidden command: /etc/profile.d/zz-melon.sh)
if [ "$(id -u)" != 0 ]; then
  doas /usr/libexec/melon/.gold "$(id -un)" || exit 1
  # the running Plasma session gets "the other side" right away
  if command -v plasma-apply-wallpaperimage >/dev/null && [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    plasma-apply-wallpaperimage /usr/share/wallpapers/melon-survivor-portal >/dev/null 2>&1 && rm -f ~/.config/autostart/melon-survivor.desktop
  fi
  printf '\033[1;33mgauntlet rewards unlocked:\033[0m the survivor wallpapers, the golden boot screen, your certificate in ~/Pictures\n'
  exit 0
fi
/usr/libexec/melon/melon-rewards / "${1:-}"
melon-update-grub >/dev/null 2>&1 || true      # installed systems: the golden GRUB background (the live ISO has none)
