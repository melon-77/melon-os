pkgname=dwarves
pkgver=1.32
pkgrel=0
pkgdesc="dwarves: pahole and friends, which read DWARF and write BTF (a kernel with BTF needs pahole)"
license=GPL-2.0-only
url=https://git.kernel.org/pub/scm/devel/pahole/pahole.git
source=(dwarves-1.32.tar.xz)
makedepends=(elfutils-dev zlib-dev)
build(){ cmake_setup -B build -D__LIB=lib -DBUILD_SHARED_LIBS=ON -DLIBBPF_EMBEDDED=ON; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/include $pkgdir/usr/lib/libdwarves*.so; }
