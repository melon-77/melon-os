pkgname=cmake
pkgver=4.4.3
pkgrel=0
pkgdesc="CMake: generates build files (ccmake included)"
license=BSD-3-Clause
url=https://cmake.org
source=(cmake-4.4.3.tar.gz)
makedepends=(curl-dev expat-dev zlib-dev bzip2-dev xz-dev zstd-dev libarchive-dev ncurses-dev)
depends=(ninja)
# CMake's own configure runs a few test programs (try_run): melon binaries run here (rule 18), so the
# "emulator" is plain env. libuv, jsoncpp, rhash and cppdap aren't in melon: CMake builds its bundled copies.
build(){
  cmake_setup -B build -DCMAKE_CROSSCOMPILING_EMULATOR=/usr/bin/env \
    -DCMAKE_USE_SYSTEM_CURL=ON -DCMAKE_USE_SYSTEM_EXPAT=ON -DCMAKE_USE_SYSTEM_ZLIB=ON -DCMAKE_USE_SYSTEM_BZIP2=ON \
    -DCMAKE_USE_SYSTEM_LIBLZMA=ON -DCMAKE_USE_SYSTEM_ZSTD=ON -DCMAKE_USE_SYSTEM_LIBARCHIVE=ON \
    -DBUILD_CursesDialog=ON -DBUILD_QtDialog=OFF -DSPHINX_MAN=OFF -DSPHINX_HTML=OFF \
    -DCMAKE_DOC_DIR=share/doc/cmake -DCMAKE_DATA_DIR=share/cmake
  ninja -C build -j$JOBS
}
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc; }
