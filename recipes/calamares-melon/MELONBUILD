pkgname=calamares-melon
pkgver=0.1
pkgrel=8
pkgdesc="melon's Calamares setup: the gauntlet module, branding, job configs and finishing scripts (live ISO only)"
license=GPL-3.0-or-later
makedepends=(calamares-dev extra-cmake-modules qt6-qtbase-dev qt6-qtdeclarative-dev kf6-kcoreaddons-dev yaml-cpp-dev)
depends=(calamares mpg123 melon-sounds)
builddir=$srcdir
build(){
  cp -r $startdir/modules/gauntlet $srcdir/gauntlet
  cmake_setup -S $srcdir/gauntlet -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DKDE_INSTALL_QMLDIR=lib/qt6/qml -DCalamares_DIR=$SYSROOT/usr/lib/cmake/Calamares
  ninja -C build -j$JOBS; }
package(){
  DESTDIR=$pkgdir ninja -C build install
  cp -a $startdir/files/. $pkgdir/
  mkdir -p $pkgdir/usr/share/calamares/branding
  cp -a $startdir/branding/melon $pkgdir/usr/share/calamares/branding/
  chmod 755 $pkgdir/usr/bin/* $pkgdir/usr/libexec/melon/cal-* $pkgdir/usr/libexec/melon/.pass $pkgdir/usr/libexec/melon/cal-shims/*; }
