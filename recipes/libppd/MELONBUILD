pkgname=libppd
pkgver=2.1.1
pkgrel=0
pkgdesc="OpenPrinting PPD library (classic printer drivers and the driverless PPD generator)"
license=Apache-2.0
url=https://github.com/OpenPrinting/libppd
source=(libppd-2.1.1.tar.xz)
makedepends=(cups-dev libcupsfilters-dev)
subpackages=(libppd-dev)
# CUPS 2.4 ships the PPD compiler tools (ppdc, ppdhtml, ...) itself
build(){ ./configure $conf_flags --disable-static --disable-nls --disable-ghostscript --disable-mutool --disable-acroread \
           --disable-pdftocairo --with-pdftops=pdftops --with-pdftops-path=/usr/bin/pdftops --disable-testppdfile --disable-ppdc-utils \
           --with-cups-config=$SYSROOT/usr/bin/cups-config; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/doc; }
