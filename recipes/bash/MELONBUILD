pkgname=bash
pkgver=5.3
pkgrel=10
pkgdesc="The GNU Bourne Again shell"
license=GPL-3.0-or-later
url=https://www.gnu.org/software/bash/
source=(bash-5.3.tar.xz)
makedepends=(ncurses-dev)
prepare(){ sed -i 's@/\* #define SYS_BASHRC "/etc/bash.bashrc" \*/@#define SYS_BASHRC "/etc/bash/bashrc"@' config-top.h; grep -q "^#define SYS_BASHRC" config-top.h; }
build(){
  export bash_cv_getcwd_malloc=yes bash_cv_job_control_missing=present bash_cv_sys_named_pipes=present \
    bash_cv_func_sigsetjmp=present bash_cv_printf_a_format=yes bash_cv_unusable_rtsigs=no \
    bash_cv_dev_fd=standard bash_cv_dev_stdin=present bash_cv_wcwidth_broken=no bash_cv_func_strcoll_broken=no
  ./configure $conf_flags --without-bash-malloc --with-curses --enable-readline --disable-nls \
     --with-installed-readline=no >/dev/null
  make -j$JOBS >/dev/null
}
package(){ make DESTDIR=$pkgdir install >/dev/null; rm -rf $pkgdir/usr/share/{man,info,doc,locale} $pkgdir/usr/lib/bash $pkgdir/usr/include; rm -f $pkgdir/usr/bin/bashbug;
  mkdir -p $pkgdir/etc/bash
  cat > $pkgdir/etc/bash/bashrc <<'RC'
# melon system-wide bashrc
[[ $- != *i* ]] && return
PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ '
alias ls='ls --color=auto' ll='ls -l' la='ls -la'
HISTSIZE=5000; HISTCONTROL=ignoredups
[ -r /etc/profile.d/zz-melon.sh ] && . /etc/profile.d/zz-melon.sh
RC
}
