#!/bin/sh
# melon-rewards ROOT [USER]: a gauntlet survivor's rewards: the survivor wallpapers, the badge melonfetch shows (and
# melon-update-grub reads, for the gold boot menu), the gold login screen, the gold colours, Plasma style and Konsole
# scheme, and, for USER, the certificate in ~/Pictures and the gold look on the next Plasma login
# (melon-survivor-look). Used by the installer and to unlock them for testing.
set -eu
ROOT=${1:-/} U=${2:-}
R=/usr/share/melon/.rewards
S=$ROOT/usr/share
mkdir -p "$S/wallpapers" "$ROOT/etc/melon" "$ROOT/etc/sddm.conf.d" "$S/sddm/themes/melon-gold" "$S/color-schemes" \
  "$S/plasma/desktoptheme" "$S/konsole"
cp -a $R/wallpapers/. "$S/wallpapers/"
[ -s "$ROOT/etc/melon/gauntlet-survivor" ] || date +%Y-%m-%d > "$ROOT/etc/melon/gauntlet-survivor"
# the gold editions: the login screen (melon's own, with the portal and a gold accent), colours, Plasma style, Konsole
cp -a $R/sddm/melon-gold/. "$S/sddm/themes/melon-gold/"; ln -sfn ../melon/Main.qml "$S/sddm/themes/melon-gold/Main.qml"
cp -a $R/color-schemes/. "$S/color-schemes/"
cp -a $R/desktoptheme/. "$S/plasma/desktoptheme/"
cp -a $R/konsole/. "$S/konsole/"
printf '# a gauntlet survivor (melon-rewards): the gold login screen\n[Theme]\nCurrent=melon-gold\n' > "$ROOT/etc/sddm.conf.d/20-survivor.conf"
if [ -n "$U" ] && [ -d "$ROOT/home/$U" ]; then
  ids=$(awk -F: -v u="$U" '$1==u{print $3":"$4}' "$ROOT/etc/passwd")
  mkdir -p "$ROOT/home/$U/Pictures" "$ROOT/home/$U/.config/autostart"
  /usr/libexec/melon/melon-certificate "$U" > "$ROOT/home/$U/Pictures/melon-gauntlet-certificate.svg"
  cat > "$ROOT/home/$U/.config/autostart/melon-survivor.desktop" <<DESK
[Desktop Entry]
Type=Application
Name=melon survivor look
Exec=sh -c '/usr/libexec/melon/melon-survivor-look && rm -f ~/.config/autostart/melon-survivor.desktop'
X-KDE-autostart-phase=2
NoDisplay=true
DESK
  chown "$ids" "$ROOT/home/$U/Pictures" "$ROOT/home/$U/Pictures/melon-gauntlet-certificate.svg" "$ROOT/home/$U/.config" \
    "$ROOT/home/$U/.config/autostart" "$ROOT/home/$U/.config/autostart/melon-survivor.desktop"
fi
