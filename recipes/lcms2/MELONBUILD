pkgname=lcms2
pkgver=2.17
pkgdesc="lcms2 (graphics stack)"
license=custom
source=(lcms2-2.17.tar.gz)
builddir=$srcdir/lcms2-2.17
makedepends=(libjpeg-turbo-dev)
subpackages=(lcms2-dev)
build(){ meson_setup -Dtests=disabled -Dutils=false -Dsamples=false build; ninja -C build; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; }
