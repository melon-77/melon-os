pkgname=melon-desktop
pkgver=0.1
pkgrel=21
pkgdesc="melon desktop: Plasma defaults, melon dark theme, wallpapers, splash, SDDM and GRUB look, desktop services, Welcome window and first-login app offer (through melon-welcome)"
license=MIT
# The desktop package list itself lives in scripts/desktop-packages.txt (the ISO profile), so this
# package only carries melon's own files and can be built before the whole desktop stack exists.
depends=(melon-base xdg-user-dirs melon-welcome)
builddir=$srcdir
options=(keepdirs)
package(){
  cp -a $startdir/files/. $pkgdir/
  chmod 755 $pkgdir/etc/sv/*/run $pkgdir/etc/sv/*/log/run $pkgdir/usr/bin/* $pkgdir/usr/libexec/melon/* $pkgdir/usr/libexec/melon/.gold
  for s in NetworkManager bluetoothd power-profiles-daemon sddm; do mkdir -p $pkgdir/var/log/$s; done
}
