# 32-bit (i686) additions: use up to 4 GB of RAM without PAE (PAE would rule out early Pentium M and some netbook
# CPUs); userland needs SSE2 (Pentium M, Pentium 4, Atom), see scripts/env.sh
CONFIG_X86_32=y
CONFIG_M686=y
CONFIG_X86_GENERIC=y
CONFIG_HIGHMEM4G=y
CONFIG_VMSPLIT_3G=y
CONFIG_X86_PAE=n
CONFIG_EFI_STUB=y
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_XE=n
CONFIG_HSA_AMD=n
CONFIG_DRM_RADEON=m
CONFIG_DRM_I915=m
CONFIG_DRM_GMA500=m
CONFIG_DRM_NOUVEAU=m
CONFIG_FB_VESA=y
CONFIG_SND_INTEL8X0=m
CONFIG_SND_VIA82XX=m
CONFIG_SND_ENS1371=m
CONFIG_8139TOO=m
CONFIG_B44=m
CONFIG_SKY2=m
CONFIG_VIA_RHINE=m
CONFIG_ATH5K=m
CONFIG_ATH9K=m
CONFIG_B43=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
# netbooks (MSI Wind U100 and friends): Ralink RT2860/RT2700E or Atheros AR5007 Wi-Fi, Realtek RTL8187 USB Wi-Fi
CONFIG_RT2800PCI=m
CONFIG_RTL8187=m
CONFIG_RTL8180=m
CONFIG_IPW2100=m
CONFIG_IPW2200=m
CONFIG_PATA_AMD=m
CONFIG_PATA_VIA=m
CONFIG_ATA_PIIX=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_PATA_OLDPIIX=m
