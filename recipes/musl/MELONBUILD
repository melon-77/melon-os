pkgname=musl
pkgver=1.2.5
pkgrel=1
pkgdesc="the musl C library (libc) implementation"
depends=(melon-layout)
license=MIT
url=https://musl.libc.org
source=(musl-1.2.5.tar.gz)
subpackages=(musl-dev musl-utils)
depends_musl_dev="musl linux-headers"
depends_musl_utils="musl"
pkgdesc_musl_utils="musl libc utilities (ldd, getconf-like helpers)"
provides_musl=("so:libc.so=1" "so:libc.musl-x86_64.so.1=1")
build(){ ./configure --target=$CHOST --prefix=/usr --syslibdir=/usr/lib CROSS_COMPILE=$CHOST-; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; ln -sf libc.so $pkgdir/usr/lib/ld-musl-x86_64.so.1; }
pkg_dev(){ amove usr/include 'usr/lib/*.a' 'usr/lib/*.o' usr/lib/musl-gcc.specs; }
pkg_utils(){ mkdir -p $subpkgdir/usr/bin; ln -sf ../lib/ld-musl-x86_64.so.1 $subpkgdir/usr/bin/ldd; }
