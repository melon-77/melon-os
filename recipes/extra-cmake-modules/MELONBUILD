pkgname=extra-cmake-modules
pkgver=6.24.0
pkgdesc="extra-cmake-modules"
license="LGPL-2.1-or-later OR GPL-2.0-or-later (see sources)"
source=(extra-cmake-modules-6.24.0.tar.xz)
builddir=$srcdir/extra-cmake-modules-6.24.0
build(){ cmake_setup -B build -DBUILD_DOC=OFF; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; }
