pkgname=xkeyboard-config
pkgver=2.46
pkgdesc="xkeyboard-config (graphics stack)"
license=custom
source=(xkeyboard-config-2.46.tar.xz)
builddir=$srcdir/xkeyboard-config-2.46
build(){ meson_setup -Dxkb-base=/usr/share/X11/xkb -Dcompat-rules=true -Dxorg-rules-symlinks=true build; ninja -C build; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; }
options=('!strip')
