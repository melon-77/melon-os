pkgname=hwdata
pkgver=0.394
pkgrel=0
pkgdesc="hwdata (graphics stack)"
license=custom
source=(hwdata-0.394.tar.gz)
builddir=$srcdir/hwdata-0.394
build(){ [ -x configure ] || autoreconf -fi; ./configure $conf_flags --datadir=/usr/share --disable-blacklist; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man $pkgdir/usr/share/info; }
options=('!strip')
