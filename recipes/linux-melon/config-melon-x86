# 32-bit (i686) additions: use up to 4 GB of RAM without PAE (PAE would rule out early Pentium M and some netbook
# CPUs); userland needs SSE2 (Pentium M, Pentium 4, Atom), see scripts/env.sh
CONFIG_X86_32=y
CONFIG_M686=y
CONFIG_X86_GENERIC=y
CONFIG_HIGHMEM4G=y
CONFIG_VMSPLIT_3G=y
CONFIG_X86_PAE=n
CONFIG_EFI_STUB=y
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_XE=n
CONFIG_HSA_AMD=n
CONFIG_DRM_RADEON=m
CONFIG_DRM_I915=m
CONFIG_DRM_GMA500=m
CONFIG_DRM_NOUVEAU=m
CONFIG_SND_INTEL8X0=m
CONFIG_SND_VIA82XX=m
CONFIG_SND_ENS1371=m
CONFIG_8139TOO=m
CONFIG_B44=m
CONFIG_SKY2=m
CONFIG_VIA_RHINE=m
CONFIG_ATH5K=m
CONFIG_ATH9K=m
CONFIG_B43=m
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
# netbooks (MSI Wind U100 and friends): Ralink RT2860/RT2700E or Atheros AR5007 Wi-Fi, Realtek RTL8187 USB Wi-Fi
CONFIG_RT2800PCI=m
CONFIG_RTL8187=m
CONFIG_RTL8180=m
CONFIG_IPW2100=m
CONFIG_IPW2200=m
CONFIG_PATA_AMD=m
CONFIG_PATA_VIA=m
CONFIG_ATA_PIIX=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_PATA_OLDPIIX=m
# every Wi-Fi, network, graphics and laptop driver an old 32-bit netbook or laptop might need (the owner,
# 7 October 2026: "realistically it should just work"); their firmware is in linux-firmware
# Wi-Fi on PCI: Intel 3945ABG/4965AGN, Broadcom (old b43 cards, BCM4313), Ralink rt2400/2500/61, Realtek, Intersil/ADMtek
CONFIG_IWLEGACY=m
CONFIG_IWL3945=m
CONFIG_IWL4965=m
CONFIG_B43LEGACY=m
CONFIG_BRCMSMAC=m
CONFIG_BRCMFMAC=m
CONFIG_RT2400PCI=m
CONFIG_RT2500PCI=m
CONFIG_RT61PCI=m
CONFIG_RTL8192SE=m
CONFIG_ADM8211=m
CONFIG_P54_COMMON=m
CONFIG_P54_PCI=m
# USB Wi-Fi sticks
CONFIG_ATH9K_HTC=m
CONFIG_CARL9170=m
CONFIG_RT2500USB=m
CONFIG_RT73USB=m
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RTL8192CU=m
CONFIG_ZD1211RW=m
CONFIG_MT7601U=m
CONFIG_MT76x0U=m
CONFIG_MT76x2U=m
CONFIG_P54_USB=m
CONFIG_AT76C50X_USB=m
# wired network: Atheros/Attansic (many netbooks), JMicron, Marvell, Broadcom, VIA, SiS, AMD, USB adapters
CONFIG_ATL1=m
CONFIG_ATL1E=m
CONFIG_ATL2=m
CONFIG_ALX=m
CONFIG_JME=m
CONFIG_SKGE=m
CONFIG_TIGON3=m
CONFIG_VIA_VELOCITY=m
CONFIG_SIS190=m
CONFIG_SIS900=m
CONFIG_8139CP=m
CONFIG_PCNET32=m
CONFIG_USB_RTL8150=m
CONFIG_USB_NET_RNDIS_HOST=m
# graphics: server and VM adapters (Matrox G200, ASPEED, Cirrus)
CONFIG_DRM_MGAG200=m
CONFIG_DRM_AST=m
CONFIG_DRM_CIRRUS_QEMU=m
# sound: the other HD Audio codecs, AC'97 on ATI chipsets
CONFIG_SND_HDA_CODEC_SIGMATEL=m
CONFIG_SND_HDA_CODEC_ANALOG=m
CONFIG_SND_HDA_CODEC_VIA=m
CONFIG_SND_ATIIXP=m
# laptop hotkeys, backlight and Wi-Fi switches (msi-laptop: the MSI Wind's Fn keys and its Wi-Fi/Bluetooth switch)
CONFIG_MSI_LAPTOP=m
CONFIG_MSI_WMI=m
CONFIG_ASUS_LAPTOP=m
CONFIG_IIO=m
CONFIG_ACPI_TOSHIBA=m
CONFIG_SAMSUNG_LAPTOP=m
CONFIG_SONY_LAPTOP=m
CONFIG_FUJITSU_LAPTOP=m
CONFIG_COMPAL_LAPTOP=m
CONFIG_ACERHDF=m
# CPU frequency on Pentium M and Pentium 4, temperatures, the ICH's watchdog/GPIO
CONFIG_X86_SPEEDSTEP_CENTRINO=y
CONFIG_X86_P4_CLOCKMOD=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_LPC_ICH=m
# input, card readers, Bluetooth, FireWire
CONFIG_MOUSE_PS2_SENTELIC=y
CONFIG_MISC_RTSX_USB=m
CONFIG_MMC_REALTEK_USB=m
CONFIG_MEMSTICK=m
CONFIG_BT_ATH3K=m
CONFIG_BT_HCIUART=m
CONFIG_FIREWIRE=m
CONFIG_FIREWIRE_OHCI=m
# disk controllers stay built in (installs boot without an initramfs)
CONFIG_PATA_JMICRON=y
CONFIG_SATA_SIL=y
