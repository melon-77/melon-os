pkgname=attr
pkgver=2.5.2
pkgrel=0
pkgdesc="Extended attribute tools and library (libattr)"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
url=https://savannah.nongnu.org/projects/attr
source=(attr-2.5.2.tar.xz)
subpackages=(attr-dev libattr)
depends=(libattr)
pkgdesc_libattr="Extended attribute library"
build(){ ./configure $conf_flags --disable-static --disable-nls; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/{doc,man,locale}; }
pkg_libattr(){ amove 'usr/lib/libattr.so.*'; }
