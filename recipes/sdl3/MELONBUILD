pkgname=sdl3
pkgver=3.4.2
pkgrel=0
pkgdesc="Simple DirectMedia Layer 3: windows, 2D/3D rendering, input, gamepads and audio for games"
license=Zlib
url=https://libsdl.org
source=(sdl3-3.4.2.tar.xz)
builddir=$srcdir/SDL3-3.4.2
makedepends=(linux-headers wayland-dev libxkbcommon-dev mesa-dev libdrm-dev alsa-lib-dev pipewire-dev pulseaudio-dev dbus-dev
  eudev-dev libusb-dev libx11-dev libxext-dev libxcursor-dev libxi-dev libxfixes-dev libxrandr-dev libxtst-dev)
# SDL dlopen()s its backends (Wayland, X11, EGL/GL, Vulkan, PipeWire, PulseAudio, ALSA, udev, D-Bus, libusb), so none of them
# show up as so: dependencies. These are the ones a window with keyboard, mouse and gamepads needs (rule 33); the desktop
# profile brings the rest (pipewire, vulkan-loader, X11 libraries for Xwayland).
depends=(wayland libxkbcommon mesa eudev-libs dbus-libs)
subpackages=(sdl3-dev)
# A backend that is switched on but whose library is missing stops the configure ("Couldn't find dependency package for ..."),
# so nothing is left out silently. Not in melon: libdecor (KWin draws the decorations), XScreenSaver, sndio, JACK, IBus, fcitx.
build(){ cmake_setup -B build -DSDL_SHARED=ON -DSDL_STATIC=OFF -DSDL_TEST_LIBRARY=OFF -DSDL_TESTS=OFF -DSDL_EXAMPLES=OFF \
  -DSDL_INSTALL_DOCS=OFF -DSDL_RPATH=OFF -DSDL_DEPS_SHARED=ON \
  -DSDL_WAYLAND=ON -DSDL_WAYLAND_LIBDECOR=OFF -DSDL_X11=ON -DSDL_X11_XSCRNSAVER=OFF -DSDL_KMSDRM=ON -DSDL_OPENGL=ON -DSDL_OPENGLES=ON \
  -DSDL_VULKAN=ON -DSDL_PIPEWIRE=ON -DSDL_PULSEAUDIO=ON -DSDL_ALSA=ON -DSDL_JACK=OFF -DSDL_SNDIO=OFF -DSDL_OSS=OFF \
  -DSDL_LIBUDEV=ON -DSDL_DBUS=ON -DSDL_HIDAPI=ON -DSDL_HIDAPI_LIBUSB=ON -DSDL_IBUS=OFF -DSDL_LIBURING=OFF -DSDL_FRIBIDI=OFF -DSDL_LIBTHAI=OFF
  ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; }
