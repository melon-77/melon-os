pkgname=lxqt-panel
pkgver=2.4.0
pkgrel=1
pkgdesc="The LXQt panel"
license="LGPL-2.1-or-later (see sources)"
url=https://lxqt-project.org
source=(lxqt-panel-2.4.0.tar.xz)
makedepends=(lm-sensors-dev)
subpackages=(lxqt-panel-dev)
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DUPDATE_TRANSLATIONS=OFF -DQt6LinguistTools_DIR=$M/hosttools/qt6/lib/cmake/Qt6LinguistTools -DNETWORKMONITOR_PLUGIN=OFF -DCPULOAD_PLUGIN=OFF; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; sed -i 's|^\[fancymenu\]$|[fancymenu]\nownIcon=true\nicon=/usr/share/icons/hicolor/scalable/apps/melon.svg|' $pkgdir/etc/xdg/lxqt/panel.conf; grep -q '^ownIcon=true' $pkgdir/etc/xdg/lxqt/panel.conf; [ "$APK_ARCH" = x86 ] || sed -i 's/^plugins=fancymenu,desktopswitch,/plugins=fancymenu,/' $pkgdir/etc/xdg/lxqt/panel.conf; }
