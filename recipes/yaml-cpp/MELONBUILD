pkgname=yaml-cpp
pkgver=0.8.0
pkgdesc="yaml-cpp (graphics stack)"
license=custom
source=(yaml-cpp-0.8.0.tar.xz)
builddir=$srcdir/jbeder-yaml-cpp-f732014
subpackages=(yaml-cpp-dev)
build(){ cmake_setup -B build -DYAML_BUILD_SHARED_LIBS=ON -DYAML_CPP_BUILD_TESTS=OFF -DYAML_CPP_BUILD_TOOLS=OFF -DYAML_CPP_BUILD_CONTRIB=OFF; ninja -C build; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; }
