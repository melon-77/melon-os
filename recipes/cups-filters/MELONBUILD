pkgname=cups-filters
pkgver=2.0.1
pkgrel=1
pkgdesc="OpenPrinting CUPS filters: turn documents into what printers take (PDF, PWG/Apple raster, PostScript)"
license=Apache-2.0
url=https://github.com/OpenPrinting/cups-filters
source=(cups-filters-2.0.1.tar.xz)
makedepends=(cups-dev libcupsfilters-dev libppd-dev)
# individual filters and their conversion rules (the universal filter needs Ghostscript or pdftops at configure time,
# and without either set of rules CUPS finds no way from a document to the printer)
build(){ ./configure $conf_flags --disable-static --disable-nls --enable-poppler --disable-ghostscript --disable-mutool --disable-foomatic \
           --enable-individual-cups-filters --disable-universal-cups-filter --enable-driverless --with-cups-config=$SYSROOT/usr/bin/cups-config; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/{doc,man}; }
