pkgname=libndp
pkgver=1.9
pkgrel=0
pkgdesc="libndp (graphics stack)"
license=custom
source=(libndp-1.9.tar.gz)
builddir=$srcdir/libndp-1.9
subpackages=(libndp-dev)
build(){ [ -x configure ] || autoreconf -fi; ./configure $conf_flags --disable-static CFLAGS="$CFLAGS -Wno-error=incompatible-pointer-types"; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man $pkgdir/usr/share/info; }
