pkgname=libxkbfile
pkgver=1.1.0
pkgrel=0
pkgdesc="libxkbfile (graphics stack)"
license=custom
source=(libxkbfile-1.1.0.tar.gz)
builddir=$srcdir/libxkbfile-1.1.0
makedepends=(libx11-dev)
subpackages=(libxkbfile-dev)
build(){ [ -x configure ] || autoreconf -fi; ./configure $conf_flags --disable-static; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man $pkgdir/usr/share/info; }
