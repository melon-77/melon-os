pkgname=xtrans
pkgver=1.6.0
pkgdesc="xtrans (graphics stack)"
license=custom
source=(xtrans-1.6.0.tar.gz)
builddir=$srcdir/xtrans-1.6.0
build(){ [ -x configure ] || autoreconf -fi; ./configure $conf_flags --disable-docs; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man $pkgdir/usr/share/info; }
options=('!strip')
