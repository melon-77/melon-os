pkgname=qtxdg-tools
pkgver=4.4.0
pkgrel=0
pkgdesc="qtxdg-mat, the command line tool for default applications"
license="LGPL-2.1-or-later (see sources)"
url=https://lxqt-project.org
source=(qtxdg-tools-4.4.0.tar.xz)
subpackages=(qtxdg-tools-dev)
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DUPDATE_TRANSLATIONS=OFF -DQt6LinguistTools_DIR=$M/hosttools/qt6/lib/cmake/Qt6LinguistTools; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; }
