pkgname=json-glib
pkgver=1.10.8
pkgdesc="json-glib (graphics stack)"
license=custom
source=(json-glib-1.10.8.tar.xz)
builddir=$srcdir/json-glib-1.10.8
makedepends=(glib-dev)
subpackages=(json-glib-dev)
build(){ meson_setup -Dintrospection=disabled -Dgtk_doc=disabled -Dman=false -Dtests=false -Dnls=disabled build; ninja -C build; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; }
