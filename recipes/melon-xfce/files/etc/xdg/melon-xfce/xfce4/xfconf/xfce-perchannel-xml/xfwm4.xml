<?xml version="1.0" encoding="UTF-8"?>
<!-- melon's window frames (art/xfwm4theme.py): rounded, shadowed, buttons at the right. The compositor draws the rounded
     corners and the shadows; without it the corners show black. -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="melon"/>
    <property name="title_font" type="string" value="Inter Semi-Bold 10"/>
    <property name="title_alignment" type="string" value="center"/>
    <property name="button_layout" type="string" value="|HMC"/>
    <property name="use_compositing" type="bool" value="true"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
    <property name="show_popup_shadow" type="bool" value="true"/>
    <property name="show_dock_shadow" type="bool" value="false"/>
    <property name="frame_opacity" type="int" value="100"/>
    <property name="inactive_opacity" type="int" value="100"/>
    <property name="move_opacity" type="int" value="100"/>
    <property name="resize_opacity" type="int" value="100"/>
    <property name="popup_opacity" type="int" value="100"/>
    <property name="vblank_mode" type="string" value="auto"/>
    <property name="cycle_preview" type="bool" value="true"/>
    <property name="cycle_draw_frame" type="bool" value="true"/>
    <property name="tile_on_move" type="bool" value="true"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="wrap_windows" type="bool" value="false"/>
    <property name="placement_mode" type="string" value="center"/>
    <property name="workspace_count" type="int" value="2"/>
    <property name="easy_click" type="string" value="Super"/>
  </property>
</channel>
