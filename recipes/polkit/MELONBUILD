pkgname=polkit
pkgver=127
pkgrel=1
pkgdesc="Authorization framework for privileged actions (polkit, duktape JS engine)"
license=LGPL-2.0-or-later
url=https://github.com/polkit-org/polkit
source=(polkit-127.tar.gz)
makedepends=(glib-dev expat-dev duktape-dev linux-pam-dev elogind-dev)
subpackages=(polkit-dev polkit-libs)
depends=(polkit-libs dbus)
pkgdesc_polkit_libs="polkit libraries"
options=(keepdirs)
build(){ meson_setup -Dsession_tracking=elogind -Dprivileged_group=wheel -Dsystemdsystemunitdir=/nonexistent -Dintrospection=false \
    -Dman=false -Dtests=false -Dauthfw=pam -Dexamples=false -Dgtk_doc=false -Dpolkitd_user=polkitd \
    -Dpam_include=base-auth build; ninja -C build; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/nonexistent $pkgdir/usr/share/doc $pkgdir/usr/lib/sysusers.d $pkgdir/usr/lib/tmpfiles.d
  mkdir -p $pkgdir/etc/polkit-1/rules.d
  cat > $pkgdir/etc/polkit-1/rules.d/10-melon-wheel.rules <<'RULES'
// members of wheel are administrators (same people who can use sudo)
polkit.addAdminRule(function(action, subject) { return ["unix-group:wheel"]; });
RULES
  mkdir -p $pkgdir/etc/sv/polkitd
  printf '#!/bin/sh\nexec 2>&1\nsv check dbus >/dev/null || exit 1\nexec /usr/lib/polkit-1/polkitd --no-debug\n' > $pkgdir/etc/sv/polkitd/run
  # 'sv check polkitd' means ready: polkitd owns its bus name
  printf '#!/bin/sh\ndbus-send --system --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner string:org.freedesktop.PolicyKit1 2>/dev/null | grep -q "boolean true"\n' > $pkgdir/etc/sv/polkitd/check
  chmod 755 $pkgdir/etc/sv/polkitd/run $pkgdir/etc/sv/polkitd/check
  # runit is the only thing that starts polkitd: when a daemon asked for polkit first, D-Bus activation started a
  # second copy, and the supervised one then exited and was restarted every second (the name was taken)
  sed -i 's|^Exec=.*|Exec=/bin/false|' $pkgdir/usr/share/dbus-1/system-services/org.freedesktop.PolicyKit1.service; }
pkg_libs(){ amove 'usr/lib/libpolkit-*.so.*'; }
