pkgname=eudev
pkgver=3.2.14
pkgrel=3
pkgdesc="Device manager (udev without systemd)"
license=GPL-2.0-only
url=https://github.com/eudev-project/eudev
source=(eudev-3.2.14.tar.gz)
makedepends=(kmod-dev util-linux-dev)
subpackages=(eudev-dev eudev-libs)
depends=(eudev-libs)
pkgdesc_eudev_libs="libudev"
prepare(){ autoreconf -fi; }
build(){ ./configure $conf_flags --disable-manpages --enable-kmod --enable-hwdb --disable-selinux \
   --with-rootprefix=/usr --with-rootlibdir=/usr/lib; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir sharepkgconfigdir=/usr/lib/pkgconfig install
  rm -rf $pkgdir/usr/share/man
  mkdir -p $pkgdir/etc/sv/udevd
  install -m755 $startdir/udevd.run $pkgdir/etc/sv/udevd/run
  # /etc/udev/rules.d is where local rules go (apps' setup scripts write there); melon-build drops empty
  # directories, so a note keeps it (udev reads only *.rules)
  mkdir -p $pkgdir/etc/udev/rules.d
  echo "# Local udev rules (*.rules) go here; they override /usr/lib/udev/rules.d." > $pkgdir/etc/udev/rules.d/README; }
pkg_libs(){ amove 'usr/lib/libudev.so.*'; }
