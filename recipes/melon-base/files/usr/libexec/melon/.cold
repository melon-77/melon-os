#!/bin/sh
# the quick melon installer.
#
# Layout (GPT, boots on both BIOS and UEFI):
#   1  1 MiB   BIOS boot (GRUB core for legacy BIOS)
#   2  1 GiB   FAT32  -> /boot   (kernel, GRUB, EFI/BOOT/BOOTX64.EFI or BOOTIA32.EFI)
#   3  rest    XFS    -> /
#
# Unattended use (for testing): set MELON_DISK, MELON_HOSTNAME, MELON_ROOTPW, MELON_USER,
# MELON_USERPW and MELON_YES=1 (and optionally MELON_PROFILE, MELON_WIFI_SSID/MELON_WIFI_PSK,
# MELON_ALPINE=y to add Alpine's repo as the opt-in tagged repo "@alpine", MELON_ENCRYPT=y with
# MELON_LUKSPW to encrypt / with LUKS2; /boot stays plain and a small initramfs asks for the passphrase).
#
# This is the quick installer. The desktop ISO's advertised installer is Calamares
# (with the melon gauntlet); this one installs the same thing in a handful of prompts.
#   MELON_PROFILE=base     console system
#   MELON_PROFILE=desktop  everything the desktop ISO installs (KDE Plasma, Wayland, Flatpak, ...)
set -e
PATH=/usr/bin
REPO=${MELON_REPO:-/media/melon/melon/repo}
TARGET=/mnt/melon
P=$(printf '\033[1;38;5;212m') B=$(printf '\033[1m') R=$(printf '\033[0m')

say(){ printf '%s=>%s %s%s%s\n' "$P" "$R" "$B" "$*" "$R"; }
die(){ printf '%s!! %s%s\n' "$P" "$*" "$R" >&2; exit 1; }
ask(){ # ask VAR "question" [default]
  eval "cur=\${$1:-}"; [ -n "$cur" ] && return 0
  printf '%s?%s %s%s: ' "$P" "$R" "$2" "${3:+ [$3]}"; read -r ans; [ -z "$ans" ] && ans=$3; eval "$1=\$ans"; }
askpw(){ eval "cur=\${$1:-}"; [ -n "$cur" ] && return 0
  while :; do printf '%s?%s %s: ' "$P" "$R" "$2"; stty -echo; read -r a; stty echo; echo
    printf '%s?%s again: ' "$P" "$R"; stty -echo; read -r b; stty echo; echo
    [ -n "$a" ] && [ "$a" = "$b" ] && break; echo "passwords did not match or were empty"; done; eval "$1=\$a"; }

[ "$(id -u)" = 0 ] || die "needs root"
SYSIMG=${MELON_SYSIMG:-/media/melon/melon/rootfs.sqfs}
ARCH=$(apk --print-arch)
case $ARCH in x86) EFI_TARGET=i386-efi EFI_FILE=BOOTIA32.EFI ;; *) EFI_TARGET=x86_64-efi EFI_FILE=BOOTX64.EFI ;; esac
[ -f "$SYSIMG" ] || die "melon system image not found at $SYSIMG (are you on the live ISO?)"

# theme music, at 30% volume, for as long as this runs
ICE_PID=
if [ -f /usr/share/melon/.ice ] && command -v mpg123 >/dev/null; then
  # play on the card that has the speakers, not the GPU's HDMI audio (card 0 on many laptops)
  ICE_CARD=$(melon-sound-default 2>/dev/null) ICE_PCM=$(melon-sound-default --pcm 2>/dev/null)
  if [ -n "$ICE_CARD" ]; then
    if amixer -c "$ICE_CARD" sget Master >/dev/null 2>&1; then
      amixer -c "$ICE_CARD" -q -M sset Master 30% unmute 2>/dev/null || true
      for c in PCM Speaker Headphone Front; do amixer -c "$ICE_CARD" -q -M sset "$c" 100% unmute 2>/dev/null || true; done
    else
      amixer -c "$ICE_CARD" -q -M sset PCM 30% unmute 2>/dev/null || true
    fi
    mpg123 -q --loop -1 -a "$ICE_PCM" /usr/share/melon/.ice >/dev/null 2>&1 &
    ICE_PID=$!
  fi
fi
stop_ice(){ [ -n "$ICE_PID" ] && kill "$ICE_PID" 2>/dev/null; ICE_PID=; }
trap stop_ice EXIT
trap 'stop_ice; exit 130' INT TERM
[ -t 1 ] && [ -z "${MELON_YES:-}" ] && sh /usr/share/melon/.glove
cat <<EOF
  This puts melon on a whole disk. Everything on that disk will be erased.

EOF
say "Disks"
lsblk -d -n -o NAME,SIZE,MODEL,TYPE | grep -v -E ' (rom|loop)$' | grep -v '^loop' | sed 's/^/   /'
echo
ask MELON_DISK "Disk to install to (e.g. sda, nvme0n1, vda)"
DISK=/dev/${MELON_DISK#/dev/}
[ -b "$DISK" ] || die "$DISK is not a block device"
PROFILES=$(ls /usr/share/melon/profiles 2>/dev/null | grep -v "\.services$" | xargs)
DEFPROFILE=base; [ -f /usr/share/melon/profiles/desktop ] && DEFPROFILE=desktop
ask MELON_PROFILE "What to install ($PROFILES)" $DEFPROFILE
[ -f /usr/share/melon/profiles/$MELON_PROFILE ] || die "unknown profile $MELON_PROFILE"
ask MELON_HOSTNAME "Hostname" melon
askpw MELON_ROOTPW "Root password"
ask MELON_USER "Your user name (empty for none)" ""
[ -n "$MELON_USER" ] && askpw MELON_USERPW "Password for $MELON_USER"
if ls -d /sys/class/net/*/wireless >/dev/null 2>&1; then
  ask MELON_WIFI_SSID "Wi-Fi network name (empty to skip)" ""
  [ -n "$MELON_WIFI_SSID" ] && askpw MELON_WIFI_PSK "Wi-Fi password"
fi
ask MELON_ALPINE "Also offer Alpine's packages as an opt-in @alpine repo (y/n)" n
ENCRYPT=n
if command -v cryptsetup >/dev/null; then
  ask MELON_ENCRYPT "Encrypt the system with a passphrase (LUKS) (y/n)" n
  case $MELON_ENCRYPT in y|Y|yes) ENCRYPT=y; askpw MELON_LUKSPW "Disk encryption passphrase" ;; esac
fi
if [ "${MELON_YES:-}" != 1 ]; then
  printf '\n%sErase %s and install melon? Type YES:%s ' "$B" "$DISK" "$R"; read -r ok; [ "$ok" = YES ] || die "aborted"
fi

case $DISK in *[0-9]) PP=${DISK}p ;; *) PP=$DISK ;; esac
say "Partitioning $DISK"
for m in $(grep "^$DISK" /proc/mounts | cut -d' ' -f2 | sort -r); do umount "$m"; done
wipefs -a -q "$DISK"
if [ "$ARCH" = x86 ]; then
  # 32-bit machines: classic MBR with an active boot partition. Many old BIOSes won't boot a GPT disk.
  sfdisk -q -W always "$DISK" <<EOF
label: dos
size=1GiB, type=ef, bootable
type=83
EOF
  BOOTN=1 ROOTN=2
else
  sfdisk -q -W always "$DISK" <<EOF
label: gpt
size=1MiB, type=21686148-6449-6E6F-744E-656564454649, name="bios"
size=1GiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="boot"
type=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709, name="melon"
EOF
  BOOTN=2 ROOTN=3
fi
partx -u "$DISK" 2>/dev/null || true; sleep 1; command -v udevadm >/dev/null && udevadm settle 2>/dev/null; mdev -s 2>/dev/null; sleep 1
for n in $BOOTN $ROOTN; do [ -b "$PP$n" ] || die "partition $PP$n did not appear"; done
BOOTP=$PP$BOOTN ROOTP=$PP$ROOTN

say "Creating filesystems (FAT32 /boot, XFS /)"
mkfs.vfat -F 32 -n MELONBOOT "$BOOTP" >/dev/null
ROOTDEV=$ROOTP
if [ $ENCRYPT = y ]; then
  say "Encrypting $ROOTP (LUKS2)"
  modprobe -q dm_crypt 2>/dev/null || true
  printf '%s' "$MELON_LUKSPW" | cryptsetup luksFormat --batch-mode --type luks2 "$ROOTP" -
  printf '%s' "$MELON_LUKSPW" | cryptsetup open --key-file - "$ROOTP" melonroot
  ROOTDEV=/dev/mapper/melonroot
fi
mkfs.xfs -q -f -L melon "$ROOTDEV"

say "Mounting"
mkdir -p $TARGET; mount -t xfs "$ROOTDEV" $TARGET
mkdir -p $TARGET/boot; mount -t vfat -o umask=0077 "$BOOTP" $TARGET/boot
say "Copying the melon system"
mkdir -p /run/melon-src; mount -t squashfs -o loop,ro "$SYSIMG" /run/melon-src
tar -C /run/melon-src --exclude=./boot -cf - . | tar -C $TARGET -xpf -
for f in /run/melon-src/boot/*; do [ -f "$f" ] && cp "$f" $TARGET/boot/; done
umount /run/melon-src
mkdir -p $TARGET/dev $TARGET/proc $TARGET/sys $TARGET/run
for d in dev proc sys; do mount --bind /$d $TARGET/$d; done

# make the new system's package set match the profile: the system image can hold more than the profile
# (the desktop ISO's image has the desktop and the live-only installer packages), or less
grep -v '^#' /usr/share/melon/profiles/$MELON_PROFILE | grep . > /tmp/melon-want
DEL=$(grep -vxF -f /tmp/melon-want $TARGET/etc/apk/world | xargs || true)
ADD=$(grep -vxF -f $TARGET/etc/apk/world /tmp/melon-want | xargs || true)
APKT="apk --root $TARGET --arch $ARCH --repositories-file /dev/null --repository $REPO/$ARCH/Packages.adb --no-cache"
if [ -n "$DEL" ]; then say "Removing what the $MELON_PROFILE profile doesn't include"; $APKT del $DEL >/dev/null; fi
if [ -n "$ADD" ]; then say "Installing the $MELON_PROFILE profile with apk"; $APKT add $ADD; fi

say "Configuring the system"
mkdir -p $TARGET/var/lib/melon
cp -a "$REPO" $TARGET/var/lib/melon/repo
echo "/var/lib/melon/repo/$ARCH/Packages.adb" > $TARGET/etc/apk/repositories
echo "$MELON_HOSTNAME" > $TARGET/etc/hostname
sed -i "s/^127.0.1.1.*/127.0.1.1\t$MELON_HOSTNAME/" $TARGET/etc/hosts
ROOT_UUID=$(blkid -s UUID -o value "$ROOTDEV"); BOOT_UUID=$(blkid -s UUID -o value "$BOOTP")
cat > $TARGET/etc/fstab <<EOF
# <device>                                 <mountpoint> <type> <options>                 <dump> <pass>
UUID=$ROOT_UUID  /            xfs    defaults,noatime          0      1
UUID=$BOOT_UUID                             /boot        vfat   defaults,umask=0077       0      2
tmpfs                                      /tmp         tmpfs  nosuid,nodev,mode=1777    0      0
EOF
# a swap file (RAM size, at most 8 GiB, and never more than an eighth of the disk); the desktop adds zram
memk=$(awk '/MemTotal/{print $2}' /proc/meminfo); freek=$(df -k $TARGET | awk 'NR==2{print $4}')
swapm=$(( memk / 1024 )); [ $swapm -gt 8192 ] && swapm=8192
[ $(( freek / 1024 / 8 )) -lt $swapm ] && swapm=$(( freek / 1024 / 8 ))
if [ $swapm -ge 256 ]; then
  say "Creating a ${swapm} MiB swap file"
  fallocate -l ${swapm}M $TARGET/swapfile 2>/dev/null || dd if=/dev/zero of=$TARGET/swapfile bs=1M count=$swapm 2>/dev/null
  chmod 600 $TARGET/swapfile; mkswap $TARGET/swapfile >/dev/null
  echo "/swapfile                                  none         swap   defaults,pri=10           0      0" >> $TARGET/etc/fstab
fi
echo "root:$MELON_ROOTPW" | chroot $TARGET chpasswd -c sha512
if [ -n "$MELON_USER" ]; then
  chroot $TARGET adduser -D -s /bin/bash -G users "$MELON_USER"
  for g in wheel audio video input render plugdev netdev kvm cdrom; do chroot $TARGET addgroup "$MELON_USER" $g 2>/dev/null || true; done
  echo "$MELON_USER:$MELON_USERPW" | chroot $TARGET chpasswd -c sha512
fi
SVCS="getty-tty1 getty-tty2 getty-tty3 mdevd syslogd klogd crond ntpd dhcp"
# <profile>.services: one service per line; "name" enables it, "-name" drops a base service
# (the desktop profile swaps mdevd/dhcp for udevd and NetworkManager)
if [ -f /usr/share/melon/profiles/$MELON_PROFILE.services ]; then
  for s in $(grep -v '^#' /usr/share/melon/profiles/$MELON_PROFILE.services); do
    case $s in -*) SVCS=$(printf '%s\n' $SVCS | grep -vxF -- "${s#-}" | xargs) ;; *) SVCS="$SVCS $s" ;; esac
  done
fi
if [ -n "${MELON_WIFI_SSID:-}" ]; then
  if [ -d $TARGET/etc/NetworkManager ]; then
    # desktop: NetworkManager owns Wi-Fi, so hand it the network instead of wpa_supplicant's own config
    NMC=$TARGET/etc/NetworkManager/system-connections; mkdir -p $NMC
    cat > "$NMC/melon-wifi.nmconnection" <<EOF
[connection]
id=$MELON_WIFI_SSID
type=wifi
autoconnect=true

[wifi]
mode=infrastructure
ssid=$MELON_WIFI_SSID

[wifi-security]
key-mgmt=wpa-psk
psk=$MELON_WIFI_PSK

[ipv4]
method=auto

[ipv6]
method=auto
EOF
    chmod 600 "$NMC/melon-wifi.nmconnection"
  else
    wpa_passphrase "$MELON_WIFI_SSID" "$MELON_WIFI_PSK" | grep -v '#psk' >> $TARGET/etc/wpa_supplicant/wpa_supplicant.conf
    SVCS="$SVCS wpa_supplicant dhcp-wifi"
  fi
fi
if [ "${MELON_SERIAL:-0}" = 1 ]; then   # serial console, for headless machines and VMs
  printf 'GRUB_SERIAL=1\nGRUB_CMDLINE_LINUX="console=tty0 console=ttyS0,115200"\n' >> $TARGET/etc/default/grub
  SVCS="$SVCS getty-ttyS0"
fi
for s in $SVCS; do if [ -d $TARGET/etc/sv/$s ]; then ln -sfn /etc/sv/$s $TARGET/var/service/$s; fi; done
case $MELON_ALPINE in y|Y|yes) say "Adding Alpine as the opt-in @alpine repo"; chroot $TARGET melon-repo enable alpine >/dev/null || true ;; esac

say "Installing GRUB for BIOS and UEFI"
chroot $TARGET grub-install --target=i386-pc --boot-directory=/boot "$DISK" 2>&1 | grep -v '^Installing for' || true
chroot $TARGET grub-install --target=$EFI_TARGET --efi-directory=/boot --boot-directory=/boot --removable --no-nvram 2>&1 | grep -v '^Installing for' || true
[ -f $TARGET/boot/EFI/BOOT/$EFI_FILE ] || die "UEFI GRUB was not installed"
[ -f $TARGET/boot/grub/i386-pc/core.img ] || die "BIOS GRUB was not installed"
if [ $ENCRYPT = y ]; then
  say "Building the unlock initramfs"
  mkdir -p $TARGET/etc/melon; : > $TARGET/etc/melon/encrypted-root
  chroot $TARGET melon-mkinitramfs
fi
MELON_ROOT_DEV="$ROOTDEV" MELON_BOOT_DEV="$BOOTP" chroot $TARGET melon-update-grub

say "Finishing"
sync
for d in dev proc sys; do umount $TARGET/$d; done
umount $TARGET/boot; umount $TARGET
[ $ENCRYPT = y ] && cryptsetup close melonroot
cat <<EOF

${P}  melon is installed on $DISK.${R}
  Remove the install media and run ${B}reboot${R}.

EOF
