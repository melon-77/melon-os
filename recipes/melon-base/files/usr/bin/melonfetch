#!/bin/sh
# melonfetch: system summary with the melon logo
. /etc/os-release 2>/dev/null
P=$(printf '\033[1;38;5;212m') G=$(printf '\033[1;38;5;114m') B=$(printf '\033[1m') R=$(printf '\033[0m')
up=$(awk '{s=int($1); d=int(s/86400); h=int(s%86400/3600); m=int(s%3600/60); if(d) printf "%dd ",d; printf "%dh %dm", h, m}' /proc/uptime)
mem=$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%d MiB / %d MiB", (t-a)/1024, t/1024}' /proc/meminfo)
cpu=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1)
host=$(cat /sys/class/dmi/id/product_name 2>/dev/null)
pkgs=$(apk list --installed 2>/dev/null | wc -l)
init=runit; [ -d /run/runit ] || init="runit"
shell=$(basename "${SHELL:-sh}")
cat <<EOF
${P}       .-~~~~~~~~-.       ${R}  ${B}$(id -un)@$(hostname)${R}
${P}     .'  .   .   . '.     ${R}  ${P}os${R}      ${PRETTY_NAME:-melon} ($(uname -m))
${P}    /  .   .   .   . \\    ${R}  ${P}host${R}    ${host:-unknown}
${P}   ;  .  .   .   .  . ;   ${R}  ${P}kernel${R}  $(uname -r)
${G}   |~~~~~~~~~~~~~~~~~~|   ${R}  ${P}init${R}    $init
${G}    \\________________/    ${R}  ${P}libc${R}    musl
${R}                            ${P}pkgs${R}    $pkgs (apk)
${R}                            ${P}shell${R}   $shell
${R}                            ${P}cpu${R}     ${cpu:-unknown}
${R}                            ${P}memory${R}  $mem
${R}                            ${P}uptime${R}  $up
EOF
