#!/bin/sh
# melon runit stage 1: one-time system initialisation
PATH=/usr/bin
. /etc/runit/functions
msg "Welcome to melon"
mountpoint -q /proc || mount -t proc proc /proc -o nosuid,noexec,nodev
mountpoint -q /sys  || mount -t sysfs sys /sys -o nosuid,noexec,nodev
mountpoint -q /run  || mount -t tmpfs run /run -o mode=0755,nosuid,nodev
# boot timeline for melon-boottime: seconds since the kernel started, one line per milestone
mark(){ read up _ < /proc/uptime; echo "$1 $up" >> /run/melon-boot-times; }
mark stage1
mountpoint -q /dev  || mount -t devtmpfs dev /dev -o mode=0755,nosuid
mkdir -p /dev/pts /dev/shm /run/lock
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts -o mode=0620,gid=5,nosuid,noexec
mountpoint -q /dev/shm || mount -t tmpfs shm /dev/shm -o mode=1777,nosuid,nodev
mountpoint -q /sys/fs/cgroup || mount -t cgroup2 -o nsdelegate cgroup2 /sys/fs/cgroup 2>/dev/null
[ -d /sys/firmware/efi/efivars ] && { mountpoint -q /sys/firmware/efi/efivars || mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null; }
ln -sf /proc/self/fd /dev/fd; ln -sf fd/0 /dev/stdin; ln -sf fd/1 /dev/stdout; ln -sf fd/2 /dev/stderr

# wait until the devices /etc/fstab names exist (udev makes their /dev/disk links): the only thing stage 1 needs from udev
wait_fstab_devices(){
  waited=0
  [ -r /etc/fstab ] || return 0
  while read -r dev _ _ opts _; do
    case $dev in ''|'#'*) continue ;; esac
    case ,$opts, in *,noauto,*|*,nofail,*) continue ;; esac
    case $dev in
      UUID=*)      node=/dev/disk/by-uuid/${dev#UUID=} ;;
      PARTUUID=*)  node=/dev/disk/by-partuuid/${dev#PARTUUID=} ;;
      LABEL=*)     node=/dev/disk/by-label/${dev#LABEL=} ;;
      PARTLABEL=*) node=/dev/disk/by-partlabel/${dev#PARTLABEL=} ;;
      /dev/*)      node=$dev ;;
      *)           continue ;;
    esac
    while [ ! -e "$node" ] && [ $waited -lt 400 ]; do sleep 0.05; waited=$((waited + 1)); done   # at most 20 s in all
  done < /etc/fstab
}

if [ -x /usr/bin/udevd ]; then
  # desktop systems: eudev handles devices
  msg "Starting devices (udev)"
  udevd --daemon
  udevadm trigger --action=add --type=subsystems
  udevadm trigger --action=add --type=devices
  mark udev-started
  if grep -q 'melon\.udev=sync' /proc/cmdline; then
    # the old way (kernel option melon.udev=sync): wait for every device, stop udevd; the udevd service starts a new one
    udevadm settle --timeout=20
    udevadm control --exit
  else
    # Stage 1 needs only the devices in /etc/fstab. udevd keeps running and works through the rest of the coldplug (the
    # GPU's driver and firmware, Wi-Fi, sound) while the services start; the udevd service adopts it, so udev never
    # restarts and no event is lost. Services that need a device wait for it themselves (SDDM waits until elogind says seat0 is graphical).
    wait_fstab_devices
    ( udevadm settle --timeout=60; mark udev-settled ) &
  fi
else
  msg "Starting devices"
  mark udev-started
  mdev -s
  # coldplug: load drivers for hardware that is already present
  find /sys/devices -name modalias -type f -exec cat {} + 2>/dev/null | sort -u | xargs -r modprobe -a -b -q 2>/dev/null
  mdev -s
fi
[ -s /etc/modules ] && grep -v '^#' /etc/modules | xargs -r modprobe -a -q
# drop-ins from other packages (/etc/modules is melon-base's own file)
cat /etc/modules-load.d/*.conf 2>/dev/null | grep -v -e '^#' -e '^$' | xargs -r modprobe -a -q
# VMware's own display driver, only on real VMware (see /etc/modprobe.d/melon-vm.conf)
[ "$(melon-detect-virt 2>/dev/null)" = vmware ] && modprobe -q vmwgfx

# point ALSA at the speakers rather than HDMI audio (sound codecs finish probing a moment later)
( sleep 4; melon-sound-default --write >/dev/null 2>&1 ) &

mark devices-ready
msg "Mounting filesystems"
mount -o remount,rw / 2>/dev/null
mount -a -t nosysfs,nonfs,noproc 2>/dev/null   # includes the /tmp tmpfs from fstab
swapon -a 2>/dev/null
# socket directories for X11 clients under Xwayland (KWin and Qt expect them to exist, world-writable, sticky)
mkdir -p -m 1777 /tmp/.X11-unix /tmp/.ICE-unix; chmod 1777 /tmp/.X11-unix /tmp/.ICE-unix

hostname -F /etc/hostname 2>/dev/null
sysctl -q -p /etc/sysctl.conf 2>/dev/null
for f in /etc/sysctl.d/*.conf; do [ -f "$f" ] && sysctl -q -p "$f"; done
ip link set lo up
[ -f /var/lib/random-seed ] && cat /var/lib/random-seed > /dev/urandom
hwclock -s -u 2>/dev/null
dmesg -n 3
install -m 0664 -g utmp /dev/null /run/utmp
: > /var/log/wtmp 2>/dev/null
touch /etc/runit/stopit /etc/runit/reboot 2>/dev/null; chmod 0 /etc/runit/stopit /etc/runit/reboot 2>/dev/null
mark stage1-done
msg "melon is up"
exit 0
