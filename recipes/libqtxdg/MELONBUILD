pkgname=libqtxdg
pkgver=4.4.0
pkgrel=0
pkgdesc="Qt implementation of the freedesktop.org XDG specifications"
license="LGPL-2.1-or-later (see sources)"
url=https://lxqt-project.org
source=(libqtxdg-4.4.0.tar.xz)
subpackages=(libqtxdg-dev)
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DUPDATE_TRANSLATIONS=OFF -DBUILD_TESTS=OFF -DBUILD_DEV_UTILS=OFF; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; }
