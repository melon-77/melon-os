#!/bin/sh
# melon-first-boot: the first time someone logs in to Plasma, offer the apps melon gets from Flathub
# (Firefox, VLC, Steam, Prism Launcher) and melon's own developer tools (gcc, make, ...). Runs once per user;
# "melon-first-boot --again" asks again.
done_file=${XDG_CONFIG_HOME:-$HOME/.config}/melon-first-boot.done
[ "$1" = --again ] && rm -f "$done_file"
[ -f "$done_file" ] && exit 0
[ "$(id -un)" = live ] && exit 0            # the live ISO session doesn't need this

# started from autostart: open a terminal for the questions
if [ "$1" != --in-terminal ]; then
  exec konsole --hide-menubar -p tabtitle="Welcome to melon" -e "$0" --in-terminal
fi

B=$(printf '\033[1m') O=$(printf '\033[38;5;215m') G=$(printf '\033[38;5;114m') R=$(printf '\033[0m')
cat <<EOF

  ${O}${B}Welcome to melon.${R}

  melon keeps its own system small and gets big desktop apps from Flathub:

    ${G}Firefox${R}          web browser                 org.mozilla.firefox
    ${G}VLC${R}              video and music player      org.videolan.VLC
    ${G}Steam${R}            games                       com.valvesoftware.Steam
    ${G}Prism Launcher${R}   Minecraft                   org.prismlauncher.PrismLauncher

  They need an internet connection and about 2 GB of disk.
  (Discover, the app store in the launcher, can install them later too.)

EOF
apps=""
ask(){ printf '  Install %s? [Y/n] ' "$1"; read -r a; case $a in n*|N*) return 1 ;; esac; return 0; }
ask Firefox && apps="$apps org.mozilla.firefox"
ask VLC && apps="$apps org.videolan.VLC"
ask Steam && apps="$apps com.valvesoftware.Steam"
ask "Prism Launcher" && apps="$apps org.prismlauncher.PrismLauncher"
mkdir -p "$(dirname "$done_file")"
if [ -n "$apps" ]; then
  echo; echo "  ${B}Installing from Flathub (your password may be asked for)...${R}"; echo
  if melon-flathub install $apps; then
    : > "$done_file"
    echo; echo "  ${G}Done.${R} The apps are in the launcher."
  else
    echo; echo "  That didn't work (no internet?). Run ${B}melon-first-boot --again${R} to retry."
  fi
else
  : > "$done_file"
fi

# developer tools come from melon's own repository (not Flathub), and most people don't need them: default no
devtools="gcc g++ binutils make pkgconf patch"
if ! apk info -e gcc >/dev/null 2>&1; then
  echo
  printf '  Install the developer tools (C/C++ compiler, make, pkg-config, patch; about 300 MB)? [y/N] '
  read -r a
  case $a in
    y*|Y*)
      echo; echo "  ${B}Installing from melon's repository (your password may be asked for)...${R}"; echo
      if doas apk add $devtools; then
        echo; echo "  ${G}Done.${R} gcc, g++ and make are ready in the terminal."
      else
        echo; echo "  That didn't work (no internet?). Later: ${B}doas apk add $devtools${R}"
      fi ;;
  esac
fi
echo; printf '  Press Enter to close. '; read -r _
