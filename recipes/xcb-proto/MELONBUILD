pkgname=xcb-proto
pkgver=1.17.0
pkgrel=0
pkgdesc="xcb-proto (graphics stack)"
license=custom
source=(xcb-proto-1.17.0.tar.gz)
builddir=$srcdir/xcb-proto-1.17.0
build(){ [ -x configure ] || autoreconf -fi; ./configure $conf_flags ; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man $pkgdir/usr/share/info; }
options=('!strip')
