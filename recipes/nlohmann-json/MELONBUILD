pkgname=nlohmann-json
pkgver=3.12.0
pkgrel=0
pkgdesc="JSON for Modern C++ (header-only; Nix needs it)"
license=MIT
url=https://github.com/nlohmann/json
source=(nlohmann-json-3.12.0.tar.gz)
options=('!strip')
# headers, CMake config and pkg-config file only: nothing to split off
build(){ cmake_setup -B build -DJSON_BuildTests=OFF -DJSON_Install=ON -DJSON_MultipleHeaders=ON; ninja -C build; }
package(){ DESTDIR=$pkgdir ninja -C build install; }
