pkgname=wpa_supplicant
pkgver=2.11
pkgrel=2
pkgdesc="WPA/WPA2/WPA3 client for wireless networks"
license=BSD-3-Clause
url=https://w1.fi/wpa_supplicant/
source=(wpa-2.11.tar.xz)
builddir=$srcdir/wpa-2.11/wpa_supplicant
makedepends=(libnl3-dev openssl-dev linux-headers dbus-dev)
build(){
  cat > .config <<'CFG'
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_DRIVER_WIRED=y
CONFIG_CTRL_IFACE=y
CONFIG_CTRL_IFACE_DBUS_NEW=y
CONFIG_CTRL_IFACE_DBUS_INTRO=y
CONFIG_BACKEND=file
CONFIG_TLS=openssl
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TLS=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y
CONFIG_PKCS12=y
CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_IEEE80211W=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y
CONFIG_WNM=y
CONFIG_INTERWORKING=y
CONFIG_HS20=y
CONFIG_AP=y
CONFIG_P2P=y
CONFIG_MBO=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_ELOOP=eloop
CONFIG_L2_PACKET=linux
CONFIG_OS=unix
CONFIG_DEBUG_SYSLOG=y
CONFIG_DEBUG_FILE=y
CFG
  export CFLAGS="$CFLAGS -I$SYSROOT/usr/include/libnl3" PKG_CONFIG=pkg-config
  make -j$JOBS BINDIR=/usr/bin LIBDIR=/usr/lib
}
package(){
  install -Dm755 wpa_supplicant $pkgdir/usr/bin/wpa_supplicant
  install -Dm755 wpa_cli $pkgdir/usr/bin/wpa_cli
  install -Dm755 wpa_passphrase $pkgdir/usr/bin/wpa_passphrase
  # D-Bus activation for NetworkManager (the desktop manages Wi-Fi through it)
  install -Dm644 dbus/dbus-wpa_supplicant.conf $pkgdir/usr/share/dbus-1/system.d/wpa_supplicant.conf
  install -Dm644 dbus/fi.w1.wpa_supplicant1.service $pkgdir/usr/share/dbus-1/system-services/fi.w1.wpa_supplicant1.service
  install -Dm600 /dev/stdin $pkgdir/etc/wpa_supplicant/wpa_supplicant.conf <<'CONF'
ctrl_interface=DIR=/run/wpa_supplicant GROUP=wheel
update_config=1
# add networks with:  wpa_passphrase "SSID" "password" >> /etc/wpa_supplicant/wpa_supplicant.conf
CONF
}
