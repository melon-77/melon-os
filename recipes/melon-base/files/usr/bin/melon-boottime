#!/bin/sh
# melon-boottime: where this boot's time went (seconds since the kernel started).
# Stage 1 writes a line per milestone to /run/melon-boot-times; the daemons' start times come from their processes.
# Firmware (BIOS/UEFI) and the GRUB menu run before the kernel and aren't counted here.
# udev-settled is when udev finished the whole coldplug (the GPU driver, Wi-Fi firmware and so on); stage 1 doesn't wait
# for it, so it can come after stage1-done.
export PATH=/usr/bin
[ -r /run/melon-boot-times ] || { echo "no boot timeline in /run/melon-boot-times (booted before melon-base 0.1-r33?)" >&2; exit 1; }
read now _ < /proc/uptime
sort -k2 -n /run/melon-boot-times | awk -v now="$now" '
  { name[++n] = $1; t[n] = $2 }
  END {
    prev = 0
    printf "%-16s %8s %8s\n", "milestone", "at (s)", "took (s)"
    for (i = 1; i <= n; i++) { printf "%-16s %8.2f %8.2f\n", name[i], t[i], t[i] - prev; prev = t[i] }
    printf "%-16s %8.2f\n", "now", now
  }'
echo
echo "daemons (when their process started; the first of each name):"
for d in /proc/[0-9]*; do
  read -r line < "$d/stat" 2>/dev/null || continue
  comm=${line#*(}; comm=${comm%%)*}
  case $comm in
    udevd|dbus-daemon|elogind|polkitd|NetworkManager|bluetoothd|sddm|sddm-helper|sddm-greeter*|kwin_wayland|plasma_session|plasmashell) ;;
    *) continue ;;
  esac
  set -- ${line#*) }
  echo "${20} $comm"        # field 22 of /proc/PID/stat: start time in clock ticks (100 per second) since boot
done | sort -n | awk '!seen[$2]++ { printf "  %-16s started at %8.2f s\n", $2, $1 / 100 }'
