pkgname=xcb-util-image
pkgver=0.4.0
pkgdesc="xcb-util-image (graphics stack)"
license=custom
source=(xcb-util-image-0.4.0.tar.bz2)
builddir=$srcdir/xcb-util-image-0.4.0
makedepends=(xcb-util-dev)
subpackages=(xcb-util-image-dev)
build(){ [ -x configure ] || autoreconf -fi; ./configure $conf_flags --disable-static; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man $pkgdir/usr/share/info; }
