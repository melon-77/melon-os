--- a/meson.build
+++ b/meson.build
@@ -67,6 +67,11 @@
         break
     endif
 endforeach
+# melon: pkg-config puts the sysroot in front of xkb_base when cross-compiling; this path is compiled in
+_sysroot = meson.get_external_property('sys_root', '')
+if _sysroot != '' and XKB_LEGACY_ROOT.startswith(_sysroot)
+    XKB_LEGACY_ROOT = XKB_LEGACY_ROOT.replace(_sysroot, '')
+endif
 if XKB_LEGACY_ROOT == ''
     # Fallback to the legacy X11 directory
     XKB_LEGACY_ROOT = get_option('prefix')/get_option('datadir')/'X11'/'xkb'
