#!/bin/sh
exec 2>&1
# not installed (the 32-bit LXQt edition has no power-profiles-daemon): switch the service off instead of restarting
[ -x /usr/libexec/power-profiles-daemon ] || { sv down "$PWD" >/dev/null 2>&1; exit 0; }
sv check dbus >/dev/null || exit 1
# it asks polkit for its authority at startup, and only runit starts polkitd
sv check polkitd >/dev/null || exit 1
exec /usr/libexec/power-profiles-daemon
