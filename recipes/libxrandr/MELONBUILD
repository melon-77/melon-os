pkgname=libxrandr
pkgver=1.5.4
pkgdesc="libxrandr (graphics stack)"
license=custom
source=(libxrandr-1.5.4.tar.gz)
builddir=$srcdir/libXrandr-1.5.4
makedepends=(libxext-dev libxrender-dev)
subpackages=(libxrandr-dev)
build(){ [ -x configure ] || autoreconf -fi; ./configure $conf_flags --disable-static --enable-malloc0returnsnull=no; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man $pkgdir/usr/share/info; }
