#!/bin/sh
# melon-lang-offer: at Plasma login, when the chosen language isn't one melon carries (see melon-lang), offer to install
# the translations. Asks once per language per user; "melon-lang all" does it later.
[ "$(id -un)" = live ] && exit 0
msg=$(melon-lang hint 2>/dev/null) || exit 0
[ -n "$msg" ] || exit 0
lang=$(printf '%s' "$msg" | sed "s/.*for '\([^']*\)'.*/\1/")
done_file=${XDG_CONFIG_HOME:-$HOME/.config}/melon-lang-offer.done
[ "$(cat "$done_file" 2>/dev/null)" = "$lang" ] && exit 0
if [ "$1" != --in-terminal ]; then
  exec konsole --hide-menubar -p tabtitle="melon: translations" -e "$0" --in-terminal
fi
B=$(printf '\033[1m') O=$(printf '\033[38;5;215m') R=$(printf '\033[0m')
printf '\n  %smelon: translations for "%s"%s\n\n  The system speaks English until they are installed (needs the internet, about 50 MB).\n\n' "$B$O" "$lang" "$R"
printf '  Install them now? [Y/n] '; read -r a
mkdir -p "$(dirname "$done_file")"; printf '%s\n' "$lang" > "$done_file"
case $a in n*|N*) echo "  Later: sudo melon-lang all"; sleep 3; exit 0 ;; esac
if sudo melon-lang all; then echo; echo "  Done. Log out and in again to see the new language."; else echo; echo "  Did not work. Try later: sudo melon-lang all"; fi
printf '  Press Enter to close. '; read -r _
