build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; }
