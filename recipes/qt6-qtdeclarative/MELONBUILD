pkgname=qt6-qtdeclarative
pkgver=6.10.2
pkgrel=0
pkgdesc="qt6-qtdeclarative"
license="LGPL-2.1-or-later OR GPL-2.0-or-later (see sources)"
source=(qt6-qtdeclarative-6.10.2+dfsg.tar.xz)
builddir=$srcdir/qtdeclarative-everywhere-src-6.10.2
subpackages=(qt6-qtdeclarative-dev)
# 32-bit: no precompiled headers. With them the build tree takes over 11 GB (one header per QML target), and the 32-bit
# edition is usually built next to the 64-bit one on the same disk
_pch=; [ "$APK_ARCH" != x86 ] || _pch=-DBUILD_WITH_PCH=OFF
build(){ cmake_setup -B build -DQT_HOST_PATH=$M/hosttools/qt6 -DQT_HOST_PATH_CMAKE_DIR=$M/hosttools/qt6/lib/cmake -DINSTALL_BINDIR=lib/qt6/bin -DINSTALL_PUBLICBINDIR=usr/bin -DINSTALL_LIBEXECDIR=lib/qt6/libexec -DINSTALL_ARCHDATADIR=lib/qt6 -DINSTALL_DATADIR=share/qt6 -DINSTALL_INCLUDEDIR=include/qt6 -DINSTALL_MKSPECSDIR=lib/qt6/mkspecs -DINSTALL_DOCDIR=share/doc/qt6 -DINSTALL_EXAMPLESDIR=share/doc/qt6/examples -DFEATURE_qml_debug=OFF $_pch; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man; }
pkg_dev(){ default_dev; amove usr/lib/qt6/mkspecs usr/lib/qt6/metatypes usr/lib/qt6/modules usr/lib/qt6/sbom; }
