#!/bin/sh
# intro animation: an iced-out glove catching the light
C=$(printf '\033[1;38;5;51m') W=$(printf '\033[1;97m') D=$(printf '\033[38;5;39m') B=$(printf '\033[1;38;5;195m') R=$(printf '\033[0m')
glove='
                  .--.--.--.
               .--|<>|<>|<>|
               |<>|<>|<>|<>|
               |<>|<>|<>|<>|   .-.
               |<>|<>|<>|<>|  /<>/
               |<><><><><><>|/<>/
               |<><><><><><><><>/
                \<><><><><><><>/
                 |<><><><><><>|
                 |============|
                 |<><><><><><>|
                 `------------`
'
frame(){ # shimmer: a random handful of stones flash white
  printf '\033[H'
  printf '%s\n' "$glove" | awk -v s="$1" -v c="$C" -v w="$W" -v d="$D" -v r="$R" 'BEGIN{srand(s)}
    { out=""; n=split($0,ch,""); i=1
      while(i<=n){ if(ch[i]=="<" && ch[i+1]==">"){ x=rand(); out=out (x<0.12? w "**" r : (x<0.5? c "<>" r : d "<>" r)); i+=2 }
                   else { out=out d ch[i] r; i++ } }
      print out }'
}
printf '\033[2J\033[?25l'
i=0; while [ $i -lt 14 ]; do frame $((i*7919+$$)); sleep 0.12; i=$((i+1)); done
cat <<EOF
${B}     ___   ____  _____   __  __     _     _   _
    |_ _| / ___|| ____| |  \/  |   / \   | \ | |
     | | | |    |  _|   | |\/| |  / _ \  |  \| |
     | | | |___ | |___  | |  | | / ___ \ | |\  |
    |___| \____||_____| |_|  |_|/_/   \_\|_| \_|${R}

    ${D}the melon console installer. cold, quick, no questions you don't need.${R}

EOF
printf '\033[?25h'
