#!/bin/sh
# melon-lang: translations beyond the ones every melon carries.
#
#   melon-lang           say which languages are included and whether the rest is installed
#   melon-lang all       install the translations of every other language (sudo melon-lang all)
#   melon-lang remove    take them off again
#
# The ISOs and the base packages carry English and the common languages (/usr/share/melon/lang-keep); the others sit in
# each package's -lang-more part, which apk installs next to its package while the empty package melon-lang-more is installed.
set -eu
KEEP=$(grep -v '^#' /usr/share/melon/lang-keep 2>/dev/null | tr '\n' ' ')
installed(){ apk info -e melon-lang-more >/dev/null 2>&1; }
need_root(){ [ "$(id -u)" = 0 ] || { echo "melon-lang: run this as root (sudo melon-lang $*)" >&2; exit 1; }; }
case "${1:-status}" in
  status)
    echo "Included: English $KEEP"
    if installed; then echo "Every other language is installed (melon-lang-more)."
    else echo "Other languages: not installed. Run: sudo melon-lang all (needs the network)."; fi ;;
  all)    need_root "$@"; apk add melon-lang-more ;;
  remove) need_root "$@"; apk del melon-lang-more ;;
  hint)   # one line at login when the chosen language isn't here; quiet otherwise
    installed && exit 0
    l=${LANG:-}
    [ -n "$l" ] || l=$(sed -n 's/^LANG=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/plasma-localerc" 2>/dev/null | head -n1)
    b=${l%%[_@.]*}; case "$b" in ""|C|POSIX|en) exit 0 ;; esac
    case " $KEEP" in *" $b "*) exit 0 ;; esac
    echo "melon: translations for '$b' are not installed. Run: sudo melon-lang all" ;;
  *) echo "usage: melon-lang [status|all|remove]" >&2; exit 1 ;;
esac
