#!/bin/sh
# melon-survivor-look: a gauntlet survivor's look in the running session. Run once by the survivor's first login (the
# autostart from melon-rewards, removed when this succeeds) or right away by the unlock.
#   melon's default desktop (LXQt on Wayfire): gold as the accent colour, a gold ring on the lock screen, "the other side"
#   as wallpaper.
#   XFCE (melon-xfce): the melon-gold GTK theme (the gold accent in GTK, Qt and Flatpak apps).
#   Plasma (an optional install): the gold colours, Plasma style and Konsole profile, the golden melon on the lock screen.
case ":${XDG_CURRENT_DESKTOP:-}:" in *:KDE:*) plasma=1 ;; *) plasma= ;; esac
case ":${XDG_CURRENT_DESKTOP:-}:" in *:XFCE:*) xfce=1 ;; *) xfce= ;; esac
if [ -n "$xfce" ]; then
  # XFCE (melon-xfce): the gold edition of melon's GTK theme, which Qt apps follow too; Flatpak apps get it from ~/.themes
  xfconf-query -c xsettings -p /Net/ThemeName -s melon-gold || exit 1
  command -v gsettings >/dev/null && gsettings set org.gnome.desktop.interface gtk-theme melon-gold 2>/dev/null
  command -v gsettings >/dev/null && gsettings set org.gnome.desktop.interface accent-color yellow 2>/dev/null
  command -v flatpak >/dev/null && flatpak override --user --env=GTK_THEME=melon-gold 2>/dev/null
elif [ -n "$plasma" ]; then
  plasma-apply-colorscheme MelonGold >/dev/null 2>&1
  plasma-apply-desktoptheme melon-gold >/dev/null 2>&1
  kwriteconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile MelonGold.profile
  kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General \
    --key Image /usr/share/wallpapers/melon-survivor-gold/
else
  c=${XDG_CONFIG_HOME:-$HOME/.config}
  mkdir -p "$c/lxqt" "$c/swaylock"
  # the gold accent in LXQt's palette (the rest of melon's palette from /etc/xdg/lxqt/lxqt.conf stays)
  lx=$c/lxqt/lxqt.conf; [ -f "$lx" ] || : > "$lx"
  if grep -q '^\[Palette\]' "$lx"; then
    sed -i '/^\[Palette\]/,/^\[/{/^highlight_color=/d;/^link_color=/d}' "$lx"
    sed -i 's/^\[Palette\]$/[Palette]\nhighlight_color=#e8b64a\nlink_color=#e8c878/' "$lx"
  else
    sed -n '/^\[Palette\]/,/^\[/p' /etc/xdg/lxqt/lxqt.conf 2>/dev/null | grep -v '^\[' | grep -v -e '^highlight_color=' -e '^link_color=' \
      | { printf '\n[Palette]\nhighlight_color=#e8b64a\nlink_color=#e8c878\n'; cat; } >> "$lx"
  fi
  # the lock screen's ring
  [ -f "$c/swaylock/config" ] || sed -e 's/6fbf4aff/e8b64aff/g' /etc/swaylock/config > "$c/swaylock/config" 2>/dev/null || true
fi
# last, so its result says whether the session was ready: if not, the autostart tries next login.
# A survivor who also installed without Rust keeps that reward's wallpaper (melon-rust-free sets the same one)
wp=/usr/share/wallpapers/melon-survivor-portal
[ -e /etc/melon/rust-free ] && [ -d /usr/share/wallpapers/melon-farewell-ferris ] && wp=/usr/share/wallpapers/melon-farewell-ferris
/usr/libexec/melon/melon-set-wallpaper $wp >/dev/null 2>&1
