pkgname=linux-melon
pkgver=7.0.0
pkgrel=2
pkgdesc="Linux kernel for melon (generic x86_64 flavour)"
license=GPL-2.0-only
url=https://kernel.org
source=(linux-7.0.tar.gz)
builddir=$srcdir/linux-7.0
depends=(linux-firmware-amdgpu kmod)
options=('!strip')
_kmake(){ env -u PKG_CONFIG_SYSROOT_DIR -u PKG_CONFIG_LIBDIR -u CFLAGS -u CXXFLAGS -u LDFLAGS -u CC -u CXX -u LD -u AR -u NM -u STRIP -u OBJCOPY -u READELF -u OBJDUMP -u AS -u RANLIB make ARCH=$KARCH CROSS_COMPILE=$TARGET- HOSTCC=gcc KBUILD_BUILD_USER=melon KBUILD_BUILD_HOST=melon "$@"; }
build(){
  _kmake ${KARCH}_defconfig
  scripts/kconfig/merge_config.sh -m .config $startdir/config-melon $([ $MELON_ARCH = x86 ] && echo $startdir/config-melon-x86)
  _kmake olddefconfig
  _kmake -j$JOBS bzImage modules 2>&1 | grep -E 'error|Error' | head -20 || true
  [ -f arch/x86/boot/bzImage ]
}
package(){
  kver=$(_kmake -s kernelrelease)
  install -Dm644 arch/x86/boot/bzImage $pkgdir/boot/vmlinuz-melon
  install -Dm644 .config $pkgdir/boot/config-melon
  install -Dm644 System.map $pkgdir/boot/System.map-melon
  _kmake INSTALL_MOD_PATH=$pkgdir INSTALL_MOD_STRIP=1 DEPMOD=/bin/true modules_install
  mkdir -p $pkgdir/usr/lib; mv $pkgdir/lib/modules $pkgdir/usr/lib/modules; rm -rf $pkgdir/lib
  rm -f $pkgdir/usr/lib/modules/$kver/build
  echo $kver > $pkgdir/usr/lib/modules/$kver/melon-kver
}
