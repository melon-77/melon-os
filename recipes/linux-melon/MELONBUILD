pkgname=linux-melon
pkgver=7.0.0
pkgdesc="Linux kernel for melon (generic x86_64 flavour)"
license=GPL-2.0-only
url=https://kernel.org
source=(linux-7.0.tar.gz)
builddir=$srcdir/linux-7.0
depends=(linux-firmware-amdgpu)
options=('!strip')
_kmake(){ env -u PKG_CONFIG_SYSROOT_DIR -u PKG_CONFIG_LIBDIR -u CFLAGS -u CXXFLAGS -u LDFLAGS -u CC -u CXX -u LD -u AR -u NM -u STRIP -u OBJCOPY -u READELF -u OBJDUMP -u AS -u RANLIB make ARCH=x86_64 CROSS_COMPILE=$TARGET- HOSTCC=gcc KBUILD_BUILD_USER=melon KBUILD_BUILD_HOST=melon "$@"; }
build(){
  _kmake x86_64_defconfig >/dev/null
  scripts/kconfig/merge_config.sh -m .config $startdir/config-melon >/dev/null
  _kmake olddefconfig >/dev/null
  _kmake -j$JOBS bzImage modules 2>&1 | grep -E 'error|Error' | head -20 || true
  [ -f arch/x86/boot/bzImage ]
}
package(){
  kver=$(_kmake -s kernelrelease)
  install -Dm644 arch/x86/boot/bzImage $pkgdir/boot/vmlinuz-melon
  install -Dm644 .config $pkgdir/boot/config-melon
  install -Dm644 System.map $pkgdir/boot/System.map-melon
  _kmake INSTALL_MOD_PATH=$pkgdir/usr INSTALL_MOD_STRIP=1 DEPMOD=/usr/sbin/depmod modules_install >/dev/null
  rm -f $pkgdir/usr/lib/modules/$kver/build
  echo $kver > $pkgdir/usr/lib/modules/$kver/melon-kver
}
