pkgname=rsync
pkgver=3.5.1
pkgrel=0
pkgdesc="rsync: fast incremental file transfer"
license=GPL-3.0-or-later
url=https://rsync.samba.org
source=(rsync-3.5.1.tar.gz)
makedepends=(popt-dev openssl-dev zstd-dev lz4-dev zlib-dev)
# musl has no ifunc, which the SIMD rolling checksum picks its CPU variant with (Alpine turns it off too)
build(){ ./configure $conf_flags --with-included-popt=no --with-included-zlib=no --disable-xxhash --disable-md2man --disable-idn --disable-roll-simd; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; }
