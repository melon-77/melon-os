pkgname=busybox
pkgver=1.37.0
pkgrel=1
pkgdesc="Size optimized toolbox of many common UNIX utilities"
license=GPL-2.0-only
url=https://busybox.net
source=(busybox-1.37.0.tar.bz2)
# a package that shipped a command BusyBox also has (gawk's awk, GNU bc) takes its link over; when that package goes,
# the trigger puts BusyBox's link back (--install -s never replaces an existing file)
triggers_busybox=(/usr/bin)
build(){
  make defconfig
  set_cfg(){ sed -i "/^\(# \)\?$1[= ]/d" .config; echo "$1=$2" >> .config; }
  unset_cfg(){ sed -i "/^$1=/d" .config; echo "# $1 is not set" >> .config; }
  unset_cfg CONFIG_TC
  unset_cfg CONFIG_FEATURE_TC_INGRESS
  set_cfg CONFIG_UNICODE_SUPPORT y
  set_cfg CONFIG_FEATURE_MDEV_DAEMON y
  set_cfg CONFIG_FEATURE_INSTALLER y
  set_cfg CONFIG_EXTRA_CFLAGS "\"\""
  yes "" 2>/dev/null | make oldconfig CROSS_COMPILE=$TARGET- || [ -f .config ]
  make -j$JOBS CROSS_COMPILE=$TARGET- CC=$TARGET-gcc HOSTCC=gcc busybox
}
package(){
  install -Dm755 busybox $pkgdir/usr/bin/busybox
  ln -s busybox $pkgdir/usr/bin/sh
  install -Dm755 examples/udhcp/simple.script $pkgdir/usr/share/udhcpc/default.script
}
