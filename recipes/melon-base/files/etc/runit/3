#!/bin/sh
# melon runit stage 3: shutdown
PATH=/usr/bin
. /etc/runit/functions
msg "Stopping services"
sv -w 10 force-stop /var/service/* >/dev/null 2>&1
sv exit /var/service/* >/dev/null 2>&1
msg "Saving random seed"
dd if=/dev/urandom of=/var/lib/random-seed count=1 bs=512 2>/dev/null
hwclock -w -u 2>/dev/null
msg "Sending TERM to all processes"
killall5 -15; sleep 1; killall5 -9
msg "Unmounting filesystems"
swapoff -a 2>/dev/null
sync
# unmount real filesystems deepest first (e.g. /boot before /); if one is busy, make it read-only
for m in $(awk '$2!="/" && $3!~/^(proc|sysfs|devtmpfs|devpts|tmpfs|cgroup2?|efivarfs|securityfs|debugfs|mqueue|overlay|squashfs)$/{print $2}' /proc/mounts | sort -r); do
  umount "$m" 2>/dev/null || mount -o remount,ro "$m" 2>/dev/null
done
mount -o remount,ro / 2>/dev/null
sync
