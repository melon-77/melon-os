pkgname=yyjson
pkgver=0.12.0
pkgrel=0
pkgdesc="A fast JSON library in C (Wayfire's IPC)"
license=MIT
url=https://github.com/ibireme/yyjson
source=(yyjson-0.12.0.tar.gz)
subpackages=(yyjson-dev)
# shared, with yyjson.pc: without it Wayfire's wf-json would fetch yyjson with git at configure time
build(){ cmake_setup -B build -DBUILD_SHARED_LIBS=ON -DYYJSON_BUILD_TESTS=OFF -DYYJSON_BUILD_DOC=OFF; ninja -C build -j$JOBS; }
package(){ DESTDIR=$pkgdir ninja -C build install; }
