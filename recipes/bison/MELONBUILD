pkgname=bison
pkgver=3.8.2
pkgrel=0
pkgdesc="GNU Bison: generates parsers from grammars"
license=GPL-3.0-or-later
url=https://www.gnu.org/software/bison/
source=(bison-3.8.2.tar.xz)
depends=(m4)
# bison runs m4 by the path configure found (the build machine's /usr/bin/m4, the same path as melon's)
build(){ M4=/usr/bin/m4 ./configure $conf_flags --disable-nls --disable-yacc; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/{doc,info} $pkgdir/usr/lib/liby.a; }
