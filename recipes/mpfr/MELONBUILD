pkgname=mpfr
pkgver=4.2.2
pkgrel=0
pkgdesc="GNU multiple precision floating-point library"
license=LGPL-3.0-or-later
url=https://www.mpfr.org/
source=(mpfr-4.2.2.tar.xz)
makedepends=(gmp-dev)
subpackages=(mpfr-dev)
build(){ ./configure $conf_flags --disable-static; make -j$JOBS; }
package(){ make DESTDIR=$pkgdir install; rm -rf $pkgdir/usr/share/{doc,info}; }
