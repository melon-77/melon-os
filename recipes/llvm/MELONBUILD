pkgname=llvm
pkgver=21.1.8
pkgrel=2
pkgdesc="LLVM compiler infrastructure (shared library for Mesa's AMD and software renderers)"
license="Apache-2.0 WITH LLVM-exception"
url=https://llvm.org
source=(llvm-21.1.8.tar.xz)
builddir=$srcdir/llvm-toolchain-21_21.1.8
makedepends=(zlib-dev zstd-dev)
subpackages=(llvm-dev llvm-libs)
depends=(llvm-libs)
pkgdesc_llvm_libs="LLVM shared library"
# 32-bit (i686): only the X86 backend (Mesa's i915 and llvmpipe compile shaders with it; no AMDGPU there)
_targets="X86;AMDGPU" _triple=x86_64-melon-linux-musl
[ "$APK_ARCH" != x86 ] || { _targets=X86 _triple=$TARGET; }
build(){
  # Configured as a native build: melon binaries run on the build host, so the freshly built
  # llvm-tblgen can be used directly instead of building a second, host copy of it.
  cmake -G Ninja -S llvm -B build \
    -DCMAKE_C_COMPILER=$CC -DCMAKE_CXX_COMPILER=$CXX -DCMAKE_SYSROOT=$SYSROOT \
    -DCMAKE_FIND_ROOT_PATH=$SYSROOT -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \
    -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY -DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY \
    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_FLAGS="$CFLAGS" -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
    -DLLVM_TARGETS_TO_BUILD="$_targets" -DLLVM_BUILD_LLVM_DYLIB=ON -DLLVM_LINK_LLVM_DYLIB=ON \
    -DLLVM_ENABLE_RTTI=ON -DLLVM_ENABLE_ASSERTIONS=OFF -DLLVM_ENABLE_ZLIB=ON -DLLVM_ENABLE_ZSTD=ON \
    -DLLVM_ENABLE_LIBXML2=OFF -DLLVM_ENABLE_LIBEDIT=OFF -DLLVM_ENABLE_FFI=OFF -DLLVM_ENABLE_TERMINFO=OFF \
    -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF -DLLVM_INCLUDE_DOCS=OFF \
    -DLLVM_BUILD_TOOLS=ON -DLLVM_INSTALL_UTILS=OFF -DLLVM_ENABLE_BINDINGS=OFF \
    -DLLVM_HOST_TRIPLE=$_triple -DLLVM_DEFAULT_TARGET_TRIPLE=$_triple \
    -DLLVM_PARALLEL_LINK_JOBS=1
  ninja -C build -j$JOBS
}
package(){
  DESTDIR=$pkgdir ninja -C build install
  rm -rf $pkgdir/usr/share/doc $pkgdir/usr/share/man $pkgdir/usr/share/opt-viewer
  # everything links the shared libLLVM, so the ~1 GB of static component archives are not shipped, except the few
  # that tablegen tools always link statically (a standalone clang build makes clang-tblgen from them)
  local keep='libLLVM(Support|Demangle|TableGen|TableGenBasic|TableGenCommon)\.a' a
  for a in $pkgdir/usr/lib/libLLVM*.a $pkgdir/usr/lib/libLTO.a $pkgdir/usr/lib/libRemarks.a; do
    [[ $(basename $a) =~ ^$keep$ ]] || rm -f $a; done
  # ... and LLVM's CMake package must not insist on the deleted ones: find_package(LLVM) checks that every exported
  # file exists (it stopped clang's build against this package)
  sed -i -E "/_cmake_import_check_files_for_.*\\.a\" \)$/{/$keep\"/!d}" $pkgdir/usr/lib/cmake/llvm/LLVMExports-release.cmake
}
pkg_libs(){ amove 'usr/lib/libLLVM.so.*' usr/lib/libLLVM-21*.so; }
pkg_dev(){ default_dev; amove usr/bin usr/lib/cmake; }
